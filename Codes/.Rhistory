# =====================================================================
# 成员推断攻击 (MIA) 批量测试 | 100次快速验证版 + 多核并行加速
# Membership Inference Attack (MIA) Batch Test | 100 runs + Multi-core Parallel
# =====================================================================
library(glmnet)
library(mvtnorm)
library(ncvreg)
library(pbapply)  # 进度条
# =====================================================================
# 自动安装缺失依赖包（解决你的pbapply错误）
# Auto-install missing dependencies
# =====================================================================
required_packages <- c("glmnet", "mvtnorm", "ncvreg", "pbapply", "parallel")
for (pkg in required_packages) {
if (!require(pkg, character.only = TRUE)) {
cat(sprintf("正在安装缺失包: %s...\n", pkg))
install.packages(pkg, dependencies = TRUE)
library(pkg, character.only = TRUE)
}
}
# =====================================================================
# 成员推断攻击 (MIA) 批量测试 | 100次快速验证版 + 多核并行加速
# =====================================================================
# -------------------------- 🔧 测试配置区（可修改） --------------------------
NUM_ATTACKS <- 100       # 攻击次数（先跑100次验证，没问题再改回10000）
USE_PARALLEL <- TRUE     # 是否启用并行计算（TRUE=是，FALSE=串行）
NUM_CORES <- detectCores() # 自动检测所有可用CPU核心，也可手动指定如 NUM_CORES <- 4
# ---------------------------------------------------------------------------
# 1. 基础函数定义
expit <- function(x){ 1 / (1 + exp(-x)) }
generate_one_site <- function(n, p, p1, signal_strength) {
X <- matrix(rnorm(n * p), nrow = n, ncol = p)
beta_true <- rep(0, p)
beta_true[1:p1] <- signal_strength * sample(c(-1, 1), p1, replace = TRUE)
mean_prob <- expit(as.vector(X %*% beta_true))
y <- rbinom(n, 1, mean_prob)
return(list(X = X, y = y))
}
calculate_loss <- function(x, y, beta) {
prob <- expit(sum(x * beta))
prob <- max(min(prob, 1 - 1e-15), 1e-15)
loss <- - (y * log(prob) + (1 - y) * log(1 - prob))
return(loss)
}
# =====================================================================
# 🎯 单次攻击函数（并行环境独立运行）
# =====================================================================
single_mia_attack <- function(seed) {
set.seed(seed) # 每次攻击独立随机种子
# 模型参数
n <- 200; p <- 200; p1 <- 5; K <- 5; signal_strength <- 3.0
# 生成联邦数据
Xall <- NULL; Treatall <- NULL; site <- NULL
for (k in 1:K) {
site_data <- generate_one_site(n, p, p1, signal_strength)
Xall <- rbind(Xall, site_data$X)
Treatall <- c(Treatall, site_data$y)
site <- c(site, rep(k, n))
}
# 提取目标样本
member_idx <- which(site == 2)[42]
member_x <- Xall[member_idx, ]
member_y <- Treatall[member_idx]
non_member_data <- generate_one_site(1, p, p1, signal_strength)
non_member_x <- non_member_data$X[1, ]
non_member_y <- non_member_data$y[1]
# 运行Fed-FDR算法（⚠️ 确保这个函数已在全局环境定义）
local_res <- local.glm.lasso(Treatall = Treatall, Xall = Xall, site = site, weight = FALSE)
Theta_matrix <- local_res$Theta
# 计算损失
member_losses <- numeric(K)
non_member_losses <- numeric(K)
for (k in 1:K) {
member_losses[k] <- calculate_loss(member_x, member_y, Theta_matrix[k, ])
non_member_losses[k] <- calculate_loss(non_member_x, non_member_y, Theta_matrix[k, ])
}
min_loss_member <- min(member_losses)
min_loss_non_member <- min(non_member_losses)
return(list(
success = (min_loss_member < min_loss_non_member),
min_loss_member = min_loss_member,
min_loss_non_member = min_loss_non_member,
loss_difference = min_loss_non_member - min_loss_member
))
}
# =====================================================================
# 🚀 批量攻击执行（自动切换并行/串行）
# =====================================================================
cat("========================================================\n")
cat(" MIA 批量攻击测试开始\n")
cat("========================================================\n")
cat(sprintf("测试配置：%d 次独立攻击\n", NUM_ATTACKS))
cat(sprintf("并行计算：%s\n", ifelse(USE_PARALLEL, paste("启用（使用", NUM_CORES, "个核心）"), "禁用（串行）")))
cat("目标模型：Fed-FDR 联邦逻辑回归\n")
cat("攻击策略：最小交叉熵损失比较\n\n")
# 生成可复现的随机种子序列
set.seed(20260612) # 全局种子，确保每次运行得到相同的攻击结果
seeds <- sample.int(1000000, NUM_ATTACKS)
# 执行攻击
cat("正在执行攻击...\n")
if (USE_PARALLEL) {
# 创建并行集群（跨平台通用PSOCK模式）
cl <- makeCluster(NUM_CORES)
# 导出所有需要的函数和库到工作进程
clusterExport(cl, c("expit", "generate_one_site", "calculate_loss", "local.glm.lasso"))
clusterEvalQ(cl, {
library(glmnet)
library(mvtnorm)
library(ncvreg)
})
# 并行执行带进度条
attack_results <- pblapply(seeds, single_mia_attack, cl = cl)
# 关闭集群
stopCluster(cl)
} else {
# 串行执行带进度条
attack_results <- pblapply(seeds, single_mia_attack)
}
# ---------- 参数配置 ----------
total_runs <- 100       # 循环攻击次数 (默认100, 可扩展到10000)
start_seed <- 2026      # 起始随机种子
seed_step <- 1          # 每次迭代种子步长
# 准备结果存储数据框
results <- data.frame(
Seed=integer(0),
MinLossMember=numeric(0),
MinLossNonMember=numeric(0),
Success=logical(0),
stringsAsFactors=FALSE
)
# 计算损失的函数（保持原逻辑）
expit <- function(x) { 1 / (1 + exp(-x)) }
calculate_loss <- function(x, y, beta) {
prob <- expit(sum(x * beta))
prob <- max(min(prob, 1 - 1e-15), 1e-15)  # 避免 log(0)
- (y * log(prob) + (1 - y) * log(1 - prob))
}
# 循环执行攻击试验
for (i in 1:total_runs) {
# --- 生成每次试验的随机种子与数据 ---
seed_i <- start_seed + (i-1) * seed_step     # 新增: 每次迭代的种子计算方法
set.seed(seed_i)                             # 新增: 设置随机种子
# 生成 K 个站点的模拟训练数据 (与原始代码相同)
Xall <- NULL; Treatall <- NULL; site <- NULL
for (k in 1:K) {
site_data <- generate_one_site(n, p, p1, signal_strength)
Xall <- rbind(Xall, site_data$X)
Treatall <- c(Treatall, site_data$y)
site <- c(site, rep(k, n))
}
# 提取“真实成员”与生成“非成员” (与原始代码相同)
member_idx <- which(site == 2)[42]
member_x <- Xall[member_idx, ]; member_y <- Treatall[member_idx]
non_member_data <- generate_one_site(1, p, p1, signal_strength)
non_member_x <- non_member_data$X[1, ]; non_member_y <- non_member_data$y[1]
# 训练模型并获取 Theta 矩阵 (保留原逻辑)
local_res <- local.glm.lasso(Treatall = Treatall, Xall = Xall, site = site, weight = FALSE)
Theta_matrix <- local_res$Theta
# 计算成员与非成员在各站点的 Loss
member_losses <- numeric(K)
non_member_losses <- numeric(K)
for (k in 1:K) {
member_losses[k] <- calculate_loss(member_x, member_y, Theta_matrix[k, ])
non_member_losses[k] <- calculate_loss(non_member_x, non_member_y, Theta_matrix[k, ])
}
min_loss_member <- min(member_losses)
min_loss_non_member <- min(non_member_losses)
success <- (min_loss_member < min_loss_non_member)  # 成功条件：成员 Loss 更低
# 将结果记录到数据框中
result_row <- data.frame(
Seed = seed_i,
MinLossMember = min_loss_member,
MinLossNonMember = min_loss_non_member,
Success = success
)
results <- rbind(results, result_row)  # 新增: 汇总每次结果
}
# ---------- 保存结果 ----------
write.csv(results, "attack_results.csv", row.names = FALSE)   # 保存为 CSV
saveRDS(results, "attack_results.rds")                         # 新增: 保存为 RDS
# ---------- 输出统计汇总 ----------
success_count <- sum(results$Success)
success_rate <- mean(results$Success) * 100
diffs <- results$MinLossNonMember - results$MinLossMember
cat("成功次数：", success_count, "；成功率：", sprintf("%.1f%%", success_rate), "\n")
cat("平均非成员-成员 Loss 差值：", sprintf("%.4f", mean(diffs)), "\n")
# ---------- 绘制直方图 ----------
library(ggplot2)
ggplot(results, aes(x = MinLossNonMember - MinLossMember)) +
geom_histogram(bins = 30, fill="steelblue", color="black", alpha=0.7) +
labs(title="成员 vs 非成员 最低 Loss 差值分布",
x="非成员 Loss - 成员 Loss", y="频数") +
theme_minimal()  # 使用 ggplot2 绘制损失差值的直方图
View(results)
